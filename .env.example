# Read DEPLOYMENT.md. Values are examples, not working production credentials.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://database:5432/scholarai
DATABASE_USER=scholarai
DATABASE_PASSWORD=replace-with-a-long-random-database-password
APP_BASE_URL=https://scholarai.example.com
DOCUMENT_STORAGE=/app/data/documents
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=scholarai@example.com
# Optional first administrator. Remove ADMIN_PASSWORD after the initial account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
